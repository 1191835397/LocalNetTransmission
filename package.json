{
  "name": "lanlink",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1421 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "node scripts/tauri.mjs",
    "desktop:dev": "node scripts/tauri.mjs dev",
    "desktop:build": "node scripts/tauri.mjs build",
    "native:test": "node scripts/cargo.mjs test --manifest-path src-tauri/Cargo.toml",
    "native:check": "node scripts/cargo.mjs clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "native:fmt": "node scripts/cargo.mjs fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "doctor": "node scripts/doctor.mjs",
    "setup:rust": "node scripts/setup-rust.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write src tests scripts *.json *.ts index.html",
    "format:check": "prettier --check src tests scripts *.json *.ts index.html",
    "native:smoke": "node scripts/native-smoke.mjs",
    "native:transfer": "node scripts/native-transfer-smoke.mjs",
    "native:memory": "node scripts/native-memory-smoke.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "lucide-react": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
